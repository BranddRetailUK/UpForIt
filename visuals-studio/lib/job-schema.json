{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upforitevents.co.uk/schemas/visual-job-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "canvas", "brand", "content", "motion", "render"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "durationSeconds"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 180, "maximum": 4320 },
        "fps": { "enum": [25, 50] },
        "durationSeconds": { "enum": [10, 20, 30] }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logoAssetId", "palette"],
      "properties": {
        "logoAssetId": { "enum": ["roundLogo", "navLogo", "smiley", "none"] },
        "palette": { "const": "core" }
      }
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "logo_loop" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "names", "layouts", "textAnimation", "uppercase"],
          "properties": {
            "kind": { "const": "artist_batch" },
            "names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "layouts": {
              "type": "array",
              "items": { "enum": ["center", "top_third"] },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 2
            },
            "textAnimation": { "enum": ["steady_glow", "flash_pulse", "punch_flash"] },
            "uppercase": { "const": true }
          }
        }
      ]
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset", "stylePreset", "intensity", "cameraStrength", "depthSpeed", "logoScale",
        "lightSweepAmount", "particleAmount", "glitchAmount", "logoCopies",
        "flashLevel", "seamlessLoop"
      ],
      "properties": {
        "preset": { "const": "pop-depth-loop" },
        "stylePreset": { "enum": ["website", "neon", "spline"] },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "cameraStrength": { "type": "number", "minimum": 0, "maximum": 100 },
        "depthSpeed": { "type": "number", "minimum": 0, "maximum": 100 },
        "logoScale": { "type": "number", "minimum": 25, "maximum": 80 },
        "lightSweepAmount": { "type": "number", "minimum": 0, "maximum": 100 },
        "particleAmount": { "type": "number", "minimum": 0, "maximum": 100 },
        "glitchAmount": { "type": "number", "minimum": 0, "maximum": 100 },
        "logoCopies": { "type": "integer", "minimum": 1, "maximum": 6 },
        "flashLevel": { "enum": ["off", "low", "medium", "high"] },
        "seamlessLoop": { "const": true }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "master"],
      "properties": {
        "preview": { "const": "h264-960x540" },
        "master": { "const": "prores-422-hq" }
      }
    }
  }
}
