# Optional overrides. The defaults match the current UPFORIT render Mac.
AFTER_EFFECTS_APP=/Applications/Adobe After Effects 2026/Adobe After Effects 2026.app/Contents/MacOS/After Effects
AFTER_EFFECTS_APP_NAME=Adobe After Effects 2026
AERENDER_PATH=/Applications/Adobe After Effects 2026/aerender
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
CODEX_PATH=codex
FONT_SCAN_PATH=/opt/homebrew/bin/fc-scan

# Keep this inside the Visuals Studio package unless intentionally relocating it.
VISUALS_RUNTIME_ROOT=./runtime
