# Public canonical UpForIt origin.
NEXT_PUBLIC_SITE_URL=https://www.upforitevents.co.uk

# Server-only Good Game standalone-storefront connection.
GOOD_GAME_API_BASE=https://dashboard.ggapparel.co.uk
STANDALONE_STOREFRONT_KEY=upforit
STANDALONE_STOREFRONT_UPFORIT_SECRET=replace-with-the-same-random-secret-configured-on-good-game

# Server-only Postgres connection used for durable checkout intent rate limiting.
DATABASE_URL=postgresql://user:password@host:5432/database

# Meta advertising measurement. Browser code can access only the Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=replace-with-meta-pixel-id
META_CONVERSIONS_API_ACCESS_TOKEN=replace-with-conversions-api-token

# Server-only Marketing API reporting credentials.
META_AD_ACCOUNT_ID=act_replace-with-ad-account-id
META_MARKETING_API_ACCESS_TOKEN=replace-with-marketing-api-token
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_API_VERSION=v25.0

# Optional: temporarily set while validating events in Meta Events Manager, then clear it.
META_TEST_EVENT_CODE=

# Stripe credentials are intentionally not used by the UpForIt application.
