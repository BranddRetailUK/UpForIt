# Public UpForIt origin for this environment.
NEXT_PUBLIC_SITE_URL=https://www.upforitevents.co.uk

# Deployment guard. Use `testing` with Stripe test credentials; only LIVE uses `production`.
APP_ENV=production
TICKETING_ENABLED=false
MERCH_CHECKOUT_ENABLED=true

# Server-only Good Game standalone-storefront connection.
GOOD_GAME_API_BASE=https://dashboard.ggapparel.co.uk
STANDALONE_STOREFRONT_KEY=upforit
STANDALONE_STOREFRONT_UPFORIT_SECRET=replace-with-the-same-random-secret-configured-on-good-game

# Server-only Postgres connection used for durable checkout intent rate limiting.
DATABASE_URL=postgresql://user:password@host:5432/database

# Native event-ticket checkout. Never expose these values with NEXT_PUBLIC_ names.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_TICKETS_WEBHOOK_SECRET=whsec_replace_me

# Generate independent random values for each environment.
TICKET_QR_SIGNING_SECRET=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
EMAIL_JOB_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# First verified account with this email receives the admin role.
ADMIN_BOOTSTRAP_EMAIL=scott@brandd.co.uk

# SendGrid is consumed only by the private email worker.
SENDGRID_API_KEY=SG.replace_me
SENDGRID_FROM_EMAIL=scott@brandd.co.uk
SENDGRID_FROM_NAME=UPFORIT Tickets
SENDGRID_REPLY_TO_EMAIL=scott@brandd.co.uk

# Testing safety: redirect every outbound email and visibly prefix the subject.
# Leave both blank only in LIVE after validating the dedicated sender.
EMAIL_FORCE_RECIPIENT=scott@brandd.co.uk
EMAIL_SUBJECT_PREFIX=[UPFORIT TEST]
